{
  "name": "bpcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "next build",
    "start": "next start -p 5000",
    "build:chrome": "node scripts/inject-chrome.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "prebuild": "node scripts/inject-chrome.mjs && node --env-file-if-exists=.env.local scripts/db-guard.mjs && payload migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "payload": "payload",
    "migrate": "node --env-file=.env.local scripts/db-guard.mjs && payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:guard": "node --env-file=.env.local scripts/db-guard.mjs",
    "seed:admins": "node --env-file=.env.local scripts/db-guard.mjs && node --env-file=.env.local scripts/seed-cms-admins.mjs",
    "demos:import": "node --env-file=.env.local scripts/db-guard.mjs && payload run scripts/import-static-demos.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "graphql": "^16.14.2",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "payload": "^3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
