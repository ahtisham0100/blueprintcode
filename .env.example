# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.
# Required by the /admin demo uploader (src/app/api/deploy-demo) and the
# /admin/demos manager (src/app/api/demos).

# Shared password that gates the /admin uploader, the /admin/demos manager
# (list + delete published demos) AND the /admin/leads view.
ADMIN_PASSWORD=change-me

# --- Contact form: storage + email (src/app/api/contact, src/app/admin/leads) ---

# Neon Postgres connection string. Submissions are stored here and read back at
# /admin/leads. The `leads` table is created automatically on first submission.
# Neon → Project → Connection Details → copy the "pooled" connection string.
DATABASE_URL=

# Resend API key for the admin notification email. If unset, email is skipped
# (the lead is still stored). Get one at resend.com → API Keys.
RESEND_API_KEY=

# From address for the notification. Default: onboarding@resend.dev (works before
# you verify a domain). After verifying send.blueprintcode.ai in Resend, set e.g.
# LEADS_FROM="Blueprint Code <hello@send.blueprintcode.ai>"
LEADS_FROM=

# Where notifications are sent. Default: hello@blueprintcode.ai
LEADS_NOTIFY_TO=

# GitHub token used to commit demos to public/<slug>/index.html, and to list
# and delete them from /admin/demos.
# Recommended: a fine-grained PAT scoped to THIS repo with
# "Contents: Read and write" permission. Never commit the real value.
GITHUB_TOKEN=

# Optional overrides (defaults shown).
GITHUB_REPO=ahtisham0100/blueprintcode
GITHUB_BRANCH=main
