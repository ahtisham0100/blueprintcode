# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.
# Required by the /admin demo uploader (src/app/api/deploy-demo) and the
# /admin/demos manager (src/app/api/demos).

# Shared password that gates the /admin uploader, the /admin/demos manager
# (list + delete published demos) AND the /admin/leads view.
ADMIN_PASSWORD=change-me

# --- Contact form: storage + email (src/app/api/contact, src/app/admin/leads) ---

# Neon Postgres connection string. Submissions are stored here and read back at
# /admin/leads. The `leads` table is created automatically on first submission.
# Neon → Project → Connection Details → copy the "pooled" connection string.
DATABASE_URL=

# Resend API key for the admin notification email. If unset, email is skipped
# (the lead is still stored). Get one at resend.com → API Keys.
RESEND_API_KEY=

# From address for the notification. Default: onboarding@resend.dev (works before
# you verify a domain). After verifying send.blueprintcode.ai in Resend, set e.g.
# LEADS_FROM="Blueprint Code <hello@send.blueprintcode.ai>"
LEADS_FROM=

# Where notifications are sent. Default: hello@blueprintcode.ai
LEADS_NOTIFY_TO=

# GitHub token used to commit demos to public/<slug>/index.html, and to list
# and delete them from /admin/demos.
# Recommended: a fine-grained PAT scoped to THIS repo with
# "Contents: Read and write" permission. Never commit the real value.
GITHUB_TOKEN=

# Optional overrides (defaults shown).
GITHUB_REPO=ahtisham0100/blueprintcode
GITHUB_BRANCH=main

# --- New CMS (admin subdomain) ---

# Host(s) on which the CMS at /cms is served. Comma-separated; ports ignored.
# On every other host, /cms and /api/cms return 404 (see src/proxy.ts), so
# demo HTML pasted into the CMS never runs on the public origin. Production:
# admin.blueprintcode.ai. Local dev: admin.localhost (Chrome resolves
# *.localhost without a hosts-file entry → http://admin.localhost:5000).
ADMIN_HOST=admin.localhost

# Rollout switch. Off (default) keeps every CMS feature admin-only; "on"
# exposes database-served demos, the blog and the CMS sitemap on the public
# site. Flip at switch-over, not before.
CMS_PUBLIC=off

# --- Payload CMS (served at /cms on ADMIN_HOST) ---

# Signs CMS sessions and Payload internals. Long random string; never reuse.
PAYLOAD_SECRET=

# Origin of the admin host — the OAuth redirect URI is derived from it:
# <CMS_SERVER_URL>/api/cms/oauth/google/callback (register that in Google
# Cloud). Local: http://admin.localhost:5000. Prod: https://admin.blueprintcode.ai
CMS_SERVER_URL=http://admin.localhost:5000

# Google Cloud → APIs & Services → Credentials → OAuth client (Web). Consent
# screen must be "Internal" (Workspace-only). Both required for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Workspace domain whose accounts may sign in (checked on the verified token).
# An account must ALSO exist in the CMS users collection.
CMS_ALLOWED_DOMAIN=blueprintcode.ai

# Payload uses DATABASE_URL (above) but keeps its tables in the `cms` schema.
