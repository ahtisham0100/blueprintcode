# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.
# Required by the /admin demo uploader (src/app/api/deploy-demo) and the
# /admin/demos manager (src/app/api/demos).

# Shared password that gates the /admin uploader, the /admin/demos manager
# (list + delete published demos) AND the /admin/leads view.
ADMIN_PASSWORD=change-me

# --- Contact form: storage + email (src/app/api/contact, src/app/admin/leads) ---

# Neon Postgres connection string. Submissions are stored here and read back at
# /admin/leads. The `leads` table is created automatically on first submission.
# Neon → Project → Connection Details → copy the "pooled" connection string.
DATABASE_URL=

# Resend API key for the admin notification email. If unset, email is skipped
# (the lead is still stored). Get one at resend.com → API Keys.
RESEND_API_KEY=

# From address for the notification. Default: onboarding@resend.dev (works before
# you verify a domain). After verifying send.blueprintcode.ai in Resend, set e.g.
# LEADS_FROM="Blueprint Code <hello@send.blueprintcode.ai>"
LEADS_FROM=

# Where notifications are sent. Default: hello@blueprintcode.ai
LEADS_NOTIFY_TO=

# GitHub token used to commit demos to public/<slug>/index.html, and to list
# and delete them from /admin/demos.
# Recommended: a fine-grained PAT scoped to THIS repo with
# "Contents: Read and write" permission. Never commit the real value.
GITHUB_TOKEN=

# Optional overrides (defaults shown).
GITHUB_REPO=ahtisham0100/blueprintcode
GITHUB_BRANCH=main

# --- New CMS (admin subdomain) ---

# Host(s) on which the CMS at /cms is served. Comma-separated; ports ignored.
# On every other host, /cms and /api/cms return 404 (see src/proxy.ts), so
# demo HTML pasted into the CMS never runs on the public origin. Production:
# admin.blueprintcode.ai. Local dev: plain "localhost" — Google only accepts
# http://localhost (no subdomains) as an OAuth redirect — so the CMS is at
# http://localhost:5000 and the public site is tested at http://127.0.0.1:5000.
ADMIN_HOST=localhost

# Rollout switch. Off (default) keeps every CMS feature admin-only; "on"
# exposes database-served demos and their sitemap entries on the public
# site. Flip at switch-over, not before.
CMS_PUBLIC=off

# Blog switch (Phase 5), independent of CMS_PUBLIC. Off (default): /blog,
# /blog/<slug>, categories, the RSS feed and the blog's sitemap entries are
# all 404 on the public site; posts can still be written and previewed from
# the CMS. Set to "on" in Vercel to launch the blog.
BLOG_PUBLIC=off

# --- Payload CMS (served at /cms on ADMIN_HOST) ---

# Signs CMS sessions and Payload internals. Long random string; never reuse.
PAYLOAD_SECRET=

# Origin of the admin host — the OAuth redirect URI is derived from it:
# <CMS_SERVER_URL>/api/cms/oauth/google/callback (register that in Google
# Cloud). Local: http://localhost:5000. Prod: https://admin.blueprintcode.ai
CMS_SERVER_URL=http://localhost:5000

# Google Cloud → APIs & Services → Credentials → OAuth client (Web). Consent
# screen must be "Internal" (Workspace-only). Both required for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Workspace domain whose accounts may sign in (checked on the verified token).
# An account must ALSO exist in the CMS users collection.
CMS_ALLOWED_DOMAIN=blueprintcode.ai

# Payload uses DATABASE_URL (above) but keeps its tables in the `cms` schema.

# --- Media (Cloudflare R2 via S3 API; served through /media on Vercel) ---

# Cloudflare → R2 → Manage API tokens → "Object Read & Write" scoped to the
# bucket. Account ID is on the R2 overview page. Use a separate dev bucket
# locally so production files are never touched.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blueprintcode-media-dev

# Base of every public asset URL. Prod: https://media.blueprintcode.ai (a
# Vercel domain; next.config rewrites it to /media). Local: the route itself.
MEDIA_PUBLIC_URL=http://localhost:5000/media

# --- Local safety ---

# Host of the Neon *development* branch (the part after @ in DATABASE_URL).
# scripts/db-guard.mjs refuses migrations and seeds locally unless
# DATABASE_URL points here; set ALLOW_PROD_DB=1 for a deliberate one-off.
DEV_DATABASE_HOST=

# --- Demos (Phase 4) ---

# Origin of the PUBLIC site, used for demo preview links from the CMS. Prod:
# https://blueprintcode.ai (the default). Local: http://127.0.0.1:5000, since
# localhost is the admin host in dev.
PUBLIC_SITE_URL=http://127.0.0.1:5000

# --- Blueprint Builder (/builder on the public site) ---

# Switch for the client-facing Blueprint Builder: /builder, its sign-in and
# review pages, and /api/builder/*. Off (default) = all 404. Its tables live in
# the "builder" schema (migration add_builder) and the CMS dashboard lists its
# projects either way.
BUILDER_PUBLIC=off

# Signs client sessions, sign-in state and BPC review links. 32+ random
# characters, different from PAYLOAD_SECRET. Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BUILDER_SECRET=

# Sender for sign-in links and submission emails (falls back to LEADS_FROM).
# Clients receive these, so it must be on a domain verified in Resend;
# onboarding@resend.dev only delivers to the Resend account owner.
BUILDER_FROM=

# Where submitted blueprints go (falls back to LEADS_NOTIFY_TO, then
# hello@blueprintcode.ai).
BUILDER_NOTIFY_TO=
