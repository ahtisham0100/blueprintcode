 "rule_templates": {
  "oos_hide": {
   "name": "Hide out-of-stock products",
   "type": "eligibility",
   "hard": true,
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "eq",
      "value": 0
     }
    ]
   },
   "then": [
    {
     "action": "exclude",
     "message": "Out of stock"
    }
   ],
   "because": "Discovery: out-of-stock products should be hidden."
  },
  "oos_estimate": {
   "name": "Show a delivery estimate when out of stock",
   "type": "calculation",
   "hard": false,
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "eq",
      "value": 0
     }
    ]
   },
   "then": [
    {
     "action": "calculate",
     "target": "delivery_days",
     "expr": "lead_time_days + 3",
     "round": "up"
    },
    {
     "action": "message",
     "text": "Ships in about {delivery_days} days"
    }
   ],
   "because": "Discovery: show out-of-stock products with a delivery estimate."
  },
  "oos_lower": {
   "name": "Rank out-of-stock products lower",
   "type": "recommendation",
   "hard": false,
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "eq",
      "value": 0
     }
    ]
   },
   "then": [
    {
     "action": "demote",
     "amount": 20
    }
   ],
   "because": "Discovery: show out-of-stock products lower down."
  },
  "region": {
   "name": "Only show products that ship to the customer",
   "type": "stock",
   "hard": true,
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "regions",
      "op": "not_contains",
      "value": {
       "ref": "request.region"
      }
     }
    ]
   },
   "then": [
    {
     "action": "exclude",
     "message": "Doesn't ship to {request.region}"
    }
   ],
   "because": "Discovery: some products are only available in certain regions."
  },
  "nomatch_relax": {
   "name": "Show closest alternatives when nothing matches",
   "type": "fallback",
   "hard": false,
   "when": {
    "op": "all",
    "items": []
   },
   "then": [
    {
     "action": "relax",
     "field": "material"
    },
    {
     "action": "message",
     "text": "No exact matches, so here are the closest alternatives."
    }
   ],
   "because": "Discovery: show the closest alternatives and say so."
  },
  "nomatch_staff": {
   "name": "Pass unmatched requests to staff",
   "type": "fallback",
   "hard": false,
   "when": {
    "op": "all",
    "items": []
   },
   "then": [
    {
     "action": "handoff",
     "message": "Our team will find options for you."
    }
   ],
   "because": "Discovery: pass the request to staff when nothing matches."
  },
  "trade_quote": {
   "name": "Trade prices on request",
   "type": "price",
   "hard": false,
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "request",
      "field": "customer_type",
      "op": "is",
      "value": "trade"
     }
    ]
   },
   "then": [
    {
     "action": "quote_only",
     "message": "Trade pricing on request"
    }
   ],
   "because": "Discovery: trade customers see different prices."
  },
  "stock_boost": {
   "name": "Rank well-stocked products higher",
   "type": "recommendation",
   "hard": false,
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "gte",
      "value": 10
     }
    ]
   },
   "then": [
    {
     "action": "boost",
     "amount": 10
    }
   ],
   "because": "Discovery: stock levels should push products up the list."
  }
 },
