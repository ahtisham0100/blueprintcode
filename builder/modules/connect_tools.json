      "connections"
     ],
     "summary": "When an earlier answer changes: {value}.",
     "required": true,
     "recommend": "Recalculate automatically and show the customer what changed.",
     "options": [
      {
       "id": "show",
       "label": "recalculate and show what changed"
      },
      {
       "id": "silent",
       "label": "recalculate quietly"
      },
      {
       "id": "clear",
       "label": "clear later results and ask again"
      },
      {
       "id": "per",
       "label": "it depends on the connection (set in the journey editor)"
      }
     ]
    },
    {
     "id": "CX-A04",
     "type": "multi",
     "label": "What is shared across the tools?",
     "affects": [
      "connections"
     ],
     "summary": "Shared across tools: {value}.",
     "options": [
      {
       "id": "project",
       "label": "one saved project"
      },
      {
       "id": "account",
       "label": "a customer account"
      },
      {
       "id": "basket",
       "label": "one basket"
      },
      {
       "id": "quote",
       "label": "one quote",
       "implies": [
        {
         "category": "quote",
         "reason": "The result has to become a quote."
        }
       ]
      },
      {
       "id": "none",
       "label": "nothing; each tool stands alone",
       "exclusive": true
      }
     ]
    }
   ]
  },
