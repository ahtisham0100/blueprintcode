   "intro": "Order, progress and shared records.",
   "questions": [
    {
     "id": "CX-A01",
     "type": "single",
     "label": "Can someone start with any of the tools?",
     "affects": [
      "connections"
     ],
     "summary": "Starting point: {value}.",
     "required": true,
     "options": [
      {
       "id": "any",
       "label": "any tool"
      },
      {
       "id": "first",
       "label": "only the first tool"
      },
      {
       "id": "some",
       "label": "some tools, not all"
      }
     ]
    },
    {
     "id": "CX-A02",
     "type": "single",
     "label": "Can they move back and forth without losing their work?",
     "affects": [
      "connections"
     ],
     "summary": "Moving back and forth: {value}.",
     "required": true,
     "recommend": "Yes, keeping everything; later results update when an earlier answer changes.",
     "options": [
      {
       "id": "keep",
       "label": "yes, everything is kept"
      },
      {
       "id": "reset",
       "label": "yes, but later results reset"
