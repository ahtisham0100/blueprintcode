 "rules": [
  {
   "id": "R-001",
   "name": "Don't offer slow out-of-stock items",
   "type": "eligibility",
   "priority": 10,
   "hard": true,
   "status": "active",
   "source": "client",
   "owner": "Operations",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "eq",
      "value": 0
     },
     {
      "scope": "item",
      "field": "lead_time_days",
      "op": "gt",
      "value": 30
     }
    ]
   },
   "then": [
    {
     "action": "exclude",
     "message": "Out of stock with a lead time over 30 days"
    }
   ],
   "because": "We don't sell items we can't deliver within a month."
  },
  {
   "id": "R-002",
   "name": "Only show items that ship to the customer",
   "type": "eligibility",
   "priority": 20,
   "hard": true,
   "status": "active",
   "source": "client",
   "owner": "Operations",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "regions",
      "op": "not_contains",
      "value": {
       "ref": "request.region"
      }
     }
    ]
   },
   "then": [
    {
     "action": "exclude",
     "message": "Doesn't ship to {request.region}"
    }
   ],
   "because": "Carriers and duties are only set up for these regions."
  },
  {
   "id": "R-003",
   "name": "Promote well-stocked linen",
   "type": "recommendation",
   "priority": 30,
   "hard": false,
   "status": "active",
   "source": "client",
   "owner": "Merchandising",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "material",
      "op": "is",
      "value": "linen"
     },
     {
      "scope": "item",
      "field": "stock",
      "op": "gte",
      "value": 10
     }
    ]
   },
   "then": [
    {
     "action": "boost",
     "amount": 20
    }
   ],
   "because": "Summer range; we want to move the linen stock."
  },
  {
   "id": "R-004",
   "name": "Trade volume discount",
   "type": "price",
   "priority": 40,
   "hard": false,
   "status": "active",
   "source": "client",
   "owner": "Sales",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "request",
      "field": "quantity",
      "op": "gte",
      "value": 10
     },
     {
      "scope": "request",
      "field": "customer_type",
      "op": "is",
      "value": "trade"
     }
    ]
   },
   "then": [
    {
     "action": "adjust_price",
     "mode": "percent",
     "amount": -10,
     "round": "1"
    },
    {
     "action": "message",
     "text": "Trade price for 10+ units"
    }
   ],
   "because": "Standard trade terms."
  },
  {
   "id": "R-005",
   "name": "Large orders need approval",
   "type": "approval",
   "priority": 50,
   "hard": true,
   "status": "active",
   "source": "client",
   "owner": "Sales",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "request",
      "field": "quantity",
      "op": "gte",
      "value": 50
     }
    ]
   },
   "then": [
    {
     "action": "require_approval",
     "message": "Orders of 50 or more are confirmed by our trade team."
    }
   ],
   "because": "Stock has to be reserved with the supplier."
  },
  {
   "id": "R-006",
   "name": "Tailoring is quote-only for trade",
   "type": "price",
   "priority": 60,
   "hard": false,
   "status": "active",
   "source": "client",
   "owner": "Sales",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "price",
      "op": "gte",
      "value": 150
     },
     {
      "scope": "request",
      "field": "customer_type",
      "op": "is",
      "value": "trade"
     }
    ]
   },
   "then": [
    {
     "action": "quote_only",
     "message": "Trade pricing on request"
    }
   ],
   "because": "Tailoring margins are negotiated per account."
  },
  {
   "id": "R-007",
   "name": "Made-to-order delivery estimate",
   "type": "calculation",
   "priority": 70,
   "hard": false,
   "status": "active",
   "source": "client",
   "owner": "Operations",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "eq",
      "value": 0
     }
    ]
   },
   "then": [
    {
     "action": "calculate",
     "target": "delivery_days",
     "expr": "lead_time_days + 3",
     "round": "up"
    },
    {
     "action": "message",
     "text": "Made to order: ships in about {delivery_days} days"
    }
   ],
   "because": "Customers need to know when it will arrive."
  },
  {
   "id": "R-008",
   "name": "Relax material when nothing matches",
   "type": "fallback",
   "priority": 80,
   "hard": false,
   "status": "active",
   "source": "client",
   "owner": "Merchandising",
   "when": {
    "op": "all",
    "items": []
   },
   "then": [
    {
     "action": "relax",
     "field": "material"
    },
    {
     "action": "message",
     "text": "No exact matches, so we're showing other materials."
    }
   ],
   "because": "Better to show a close alternative than an empty page."
  },
  {
   "id": "R-009",
   "name": "Show out-of-stock items anyway",
   "type": "eligibility",
   "priority": 5,
   "hard": false,
   "status": "suggested",
   "source": "ai",
   "owner": "AI suggestion",
   "when": {
    "op": "all",
    "items": [
     {
      "scope": "item",
      "field": "stock",
      "op": "eq",
      "value": 0
     }
    ]
   },
   "then": [
    {
     "action": "include",
     "message": "Shown for back-order"
    }
   ],
   "because": "Could capture back-orders."
  },
  {
   "id": "R-010",
   "name": "Wool stays in the UK and EU",
   "type": "stock",
   "priority": 25,
   "hard": false,
   "status": "disabled",
